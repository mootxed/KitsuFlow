# Публичный Client ID именно GitHub App (не OAuth App).
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_APP_SLUG=
VITE_GITHUB_APP_INSTALL_URL=
# HTTPS Worker с KV binding OAUTH_SESSIONS; не секрет.
VITE_OAUTH_PROXY_URL=
# Только для явно включённого локального legacy Device Flow:
VITE_ENABLE_LEGACY_DEVICE_FLOW=false
VITE_BASE_PATH=/
VITE_APP_NAME=KitsuFlow
